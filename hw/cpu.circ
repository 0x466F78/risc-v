      <a name="text" val="AUIPC    0010111  1    01   1    00    U      0    0    00"/>
    </comp>
    <comp lib="9" loc="(1500,315)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="SYSTEM   1110011  0  (Halt = 1: ECALL/EBREAK dung CPU)"/>
    </comp>
    <comp lib="9" loc="(1500,330)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="ASel: 0=rs1 1=PC 2=0   WBSel: 0=ALU 1=Mem 2=PC+4"/>
    </comp>
    <comp lib="9" loc="(1500,345)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="ImmSel: 0=I 1=S 2=B 3=U 4=J"/>
    </comp>
    <comp lib="9" loc="(310,300)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="opcode[6:2]"/>
    </comp>
    <comp lib="9" loc="(480,595)" name="Text">
      <a name="color" val="#7c2d12"/>
      <a name="font" val="SansSerif bold 9"/>
      <a name="halign" val="left"/>
      <a name="text" val="SYSTEM"/>
    </comp>
    <comp lib="9" loc="(520,585)" name="Text">
      <a name="color" val="#7c2d12"/>
      <a name="font" val="SansSerif bold 9"/>
      <a name="halign" val="left"/>
      <a name="text" val="JAL"/>
    </comp>
    <comp lib="9" loc="(560,565)" name="Text">
