      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="Membaca RXDATA mengeluarkan karakter dari antrean (queue): → hanya aktifkan KbdRE (Keyboard Read Enable) saat berupa INSTRUKSI LOAD sungguhan (MemRead=1)."/>
    </comp>
    <comp lib="9" loc="(60,40)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="I/O Controller (memory-mapped I/O): perangkat periferal hanyalah beberapa alamat khusus:"/>
    </comp>
    <comp lib="9" loc="(60,55)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="Wilayah I/O: Addr[31:28] = 0xF. Register I/O dipilih menggunakan Addr[4:2]:"/>
    </comp>
    <comp lib="9" loc="(60,70)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="0xF0000000 UART_TXDATA (W — Tulis saja) 0xF0000004 UART_RXDATA (R — Baca saja) 0xF0000008 UART_STATUS (R — Baca saja) 0xF0000010 GPIO_OUT (R/W — Baca/Tulis) 0xF0000014 GPIO_IN (R — Baca saja)"/>
    </comp>
    <comp lib="9" loc="(60,85)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="Alamat lain di dalam wilayah tersebut: hasil baca = 0."/>
