      <a name="text" val="Load Unit: mengambil byte/halfword dari word yang dibaca lalu melakukan ekstensi tanda (sign-extend) atau mengisi dengan 0 (zero-extend):"/>
    </comp>
    <comp lib="9" loc="(60,55)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="Word &gt;&gt; (Off*8) menggeser byte/halfword yang ingin diambil ke posisi bit terendah; funct3 memilih: 000 LB, 001 LH, 010 LW, 100 LBU, 101 LHU."/>
    </comp>
    <comp lib="9" loc="(640,150)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="LB: sign-extend S[7:0]"/>
    </comp>
    <comp lib="9" loc="(640,230)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="LH: sign-extend S[15:0]"/>
    </comp>
    <comp lib="9" loc="(640,310)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="LBU: zero-extend S[7:0]"/>
    </comp>
    <comp lib="9" loc="(640,390)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="LHU: zero-extend S[15:0]"/>
    </comp>
    <comp lib="9" loc="(930,220)" name="Text">
