      <a name="font" val="SansSerif bold 9"/>
      <a name="halign" val="left"/>
      <a name="text" val="JALR"/>
    </comp>
    <comp lib="9" loc="(60,40)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="Unit Kontrol (Main Decoder) — digambar dengan gaya PLA (Programmable Logic Array):"/>
    </comp>
    <comp lib="9" loc="(60,55)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="1) Decoder 5→32 mengubah opcode[6:2] menjadi 1 jalur &quot;one-hot&quot; untuk setiap kelompok instruksi (hanya aktif saat opcode[1:0]=11)."/>
    </comp>
    <comp lib="9" loc="(60,70)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="2) Setiap sinyal kontrol = gerbang OR dari kelompok-kelompok instruksi yang membutuhkannya (kolom vertikal = kelompok instruksi, titik bulat = terhubung)."/>
    </comp>
    <comp lib="9" loc="(60,85)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="Instruksi = 0x00000000 (bubble) → opcode[1:0]=00 → decoder mati → semua sinyal = 0 = NOP."/>
    </comp>
    <comp lib="9" loc="(600,555)" name="Text">
      <a name="color" val="#7c2d12"/>
      <a name="font" val="SansSerif bold 9"/>
      <a name="halign" val="left"/>
      <a name="text" val="BRANCH"/>
    </comp>
    <comp lib="9" loc="(640,445)" name="Text">
      <a name="color" val="#7c2d12"/>
      <a name="font" val="SansSerif bold 9"/>
      <a name="halign" val="left"/>
      <a name="text" val="LUI"/>
    </comp>
    <comp lib="9" loc="(680,435)" name="Text">
      <a name="color" val="#7c2d12"/>
      <a name="font" val="SansSerif bold 9"/>
      <a name="halign" val="left"/>
      <a name="text" val="OP"/>
    </comp>
