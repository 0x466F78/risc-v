      <a name="halign" val="left"/>
      <a name="text" val="Tabel kebenaran (1 = aktif):"/>
    </comp>
    <comp lib="9" loc="(1500,155)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="Kelompok opcode  RegW ASel BSel ALUOp ImmSel MemR MemW WBSel"/>
    </comp>
    <comp lib="9" loc="(1500,170)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="OP       0110011  1    00   0    10    -      0    0    00"/>
    </comp>
    <comp lib="9" loc="(1500,185)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="OP-IMM   0010011  1    00   1    11    I      0    0    00"/>
    </comp>
    <comp lib="9" loc="(1500,200)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="LOAD     0000011  1    00   1    00    I      1    0    01"/>
    </comp>
    <comp lib="9" loc="(1500,220)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="STORE    0100011  0    00   1    00    S      0    1    --"/>
    </comp>
    <comp lib="9" loc="(1500,235)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="BRANCH   1100011  0    01   1    00    B      0    0    --"/>
    </comp>
    <comp lib="9" loc="(1500,250)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="JAL      1101111  1    01   1    00    J      0    0    10"/>
    </comp>
    <comp lib="9" loc="(1500,265)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="JALR     1100111  1    00   1    00    I      0    0    10"/>
    </comp>
    <comp lib="9" loc="(1500,280)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="LUI      0110111  1    10   1    00    U      0    0    00"/>
    </comp>
    <comp lib="9" loc="(1500,300)" name="Text">
      <a name="color" val="#1e3a8a"/>
      <a name="font" val="Monospaced plain 10"/>
